#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
set -euo pipefail

if command -v authselect >/dev/null; then
    # This fork uses conventional accounts enrolled from runtime credentials.
    authselect select local
fi

# Arch's PAM is built without a vendor-directory fallback. Preserve its native
# /etc/pam.d for factory capture and first-boot linking; Fedora uses /usr/lib.
# Neither path creates an account or access credential on the builder.
if [[ ${DISTRIBUTION:?} == arch ]]; then
    test -d /etc/pam.d
else
    if [[ -d /etc/pam.d ]]; then
        find /etc/pam.d -mindepth 1 -exec mv {} /usr/lib/pam.d \;
        rmdir /etc/pam.d
    fi
    find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_shells.so/d' {} \;
    find /usr/lib/pam.d/ -mindepth 1 -exec sed --in-place '/pam_securetty.so/d' {} \;
fi

# Preserve the distro's programmatic identity/version and ParticleOS ancestry for
# the pinned dotfiles' immutable guards. Personal OS owns the visible branding;
# /usr/lib/personal-os/immutable and lifecycle environment guards also remain.
(
    . /usr/lib/os-release
    # Arch is rolling and does not ship VERSION or VERSION_ID. Keep that identity
    # rather than inventing a release number; use rolling only in visible text.
    display_version=${VERSION:-rolling}
    version_id_line=
    if [[ -n ${VERSION_ID:-} ]]; then
        version_id_line="VERSION_ID=\"$VERSION_ID\""
    fi
    cat >/usr/lib/os-release <<EOF
NAME="Personal OS ($NAME)"
ID="$ID"
ID_LIKE="personal-os particleos-$ID $ID"
PRETTY_NAME="Personal OS / $NAME $display_version"
VERSION="$display_version"
$version_id_line
HOME_URL="https://github.com/ca-mantis-shrimp/personal-os"
EOF

    cat >/usr/lib/issue <<EOF
Personal OS / $NAME $display_version
Kernel \r on an \m (\l)

EOF
)
