[Unit]
Description=Private persistent shell sessions (agent workspace)
Requires=shpool.socket
After=shpool.socket

[Service]
Type=simple
ExecStart=/usr/bin/shpool daemon
UMask=0077
KillMode=control-group
TimeoutStopSec=10s
SendSIGHUP=yes
# Host sessions must permit setuid newuidmap/newgidmap for rootless Podman.
# shpool is NOT an isolation boundary; agent confinement belongs to the sandbox.
NoNewPrivileges=no
LimitCORE=0

[Install]
WantedBy=default.target
