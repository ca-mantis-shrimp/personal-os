[Unit]
Description=Apply target-user configuration with workloads blocked
Requires=personal-os-account.service
After=personal-os-account.service systemd-tmpfiles-setup.service
RequiresMountsFor=/home
# Prototype is explicitly disabled by preset until runtime-input gates exist.
# SSH/user-manager access requires ACCOUNT readiness, never this configuration.

[Service]
Type=oneshot
User=root
Group=root
RemainAfterExit=yes
ExecStart=/usr/libexec/personal-os-configuration
# Runs on failed/partial startup, cancellation and normal unit stop.
ExecStopPost=/usr/libexec/personal-os-configuration --stop
Environment=PATH=/usr/sbin:/usr/bin
UMask=0077
LimitCORE=0
TimeoutStartSec=20min
TimeoutStopSec=5min
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home /run/personal-os
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
