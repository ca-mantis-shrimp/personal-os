#!/usr/bin/python3
"""Target-only conventional account enrollment from systemd credentials.

No chezmoi operations. Credentials and command stderr are never logged. The
root-owned journal permits retries, but not silent adoption of existing users.
"""
from contextlib import contextmanager
import base64
import ctypes
import grp
import json
import os
from pathlib import Path
import pwd
import re
import secrets
import socket
import stat
import struct
import subprocess
import sys


class ProvisionError(Exception):
    pass


def config_from_json(data):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ProvisionError("Duplicate configuration field")
            result[key] = value
        return result
    try:
        config = json.loads(data, object_pairs_hook=unique)
    except (ValueError, UnicodeError):
        raise ProvisionError("Invalid account configuration") from None
    fields = {"version", "username", "uid", "gid", "hostname", "shell",
              "ssh_public_keys", "passwordless_sudo"}
    if not isinstance(config, dict) or set(config) != fields or type(config["version"]) is not int or config["version"] != 1:
        raise ProvisionError("Unsupported account configuration schema")
    if not isinstance(config["username"], str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", config["username"]):
        raise ProvisionError("Invalid account name")
    for key in ("uid", "gid"):
        if type(config[key]) is not int or not 1000 <= config[key] <= 60000:
            raise ProvisionError("Account IDs must be in the regular-user range")
    if not isinstance(config["hostname"], str) or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", config["hostname"]):
        raise ProvisionError("Hostname must be a single DNS label")
    if config["shell"] not in ("/usr/bin/bash", "/usr/bin/fish") or type(config["passwordless_sudo"]) is not bool:
        raise ProvisionError("Invalid shell or sudo policy")
    keys = config["ssh_public_keys"]
    if not isinstance(keys, list) or not 1 <= len(keys) <= 16:
        raise ProvisionError("At least one SSH public key is required")
    for key in keys:
        validate_key(key)
    return config


def validate_key(key):
    # Only plain public keys, not authorized_keys options, private keys or certs.
    if not isinstance(key, str) or len(key) > 16384 or any(ord(c) < 32 for c in key):
        raise ProvisionError("Invalid SSH public key")
    parts = key.split(" ", 2)
    if len(parts) < 2:
        raise ProvisionError("Invalid SSH public key")
    try:
        blob = base64.b64decode(parts[1], validate=True)
        fields = []
        while blob:
            size = struct.unpack(">I", blob[:4])[0]
            if size > len(blob) - 4:
                raise ValueError()
            fields.append(blob[4:4 + size])
            blob = blob[4 + size:]
        algorithm = parts[0]
        valid = fields and fields[0] == algorithm.encode()
        if algorithm == "ssh-ed25519":
            valid = valid and len(fields) == 2 and len(fields[1]) == 32
        elif algorithm == "ssh-rsa":
            valid = valid and len(fields) == 3 and 1 <= len(fields[1]) <= 16 and 256 <= len(fields[2]) <= 1025
        elif algorithm in {"ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521"}:
            lengths = {"nistp256": 65, "nistp384": 97, "nistp521": 133}
            curve = algorithm.removeprefix("ecdsa-sha2-")
            valid = valid and len(fields) == 3 and fields[1] == curve.encode() and len(fields[2]) == lengths[curve] and fields[2][:1] == b"\x04"
        else:
            valid = False
        if not valid:
            raise ValueError()
    except (ValueError, struct.error):
        raise ProvisionError("Invalid or unsupported SSH public key") from None


def password_from_bytes(data):
    try:
        value = data.decode("ascii").removesuffix("\n")
    except UnicodeError:
        raise ProvisionError("Invalid console password credential") from None
    # Fedora supports yescrypt and SHA-512 crypt. Never accept empty/locked or
    # plaintext credentials. No password is passed through argv or the journal.
    sha512 = r"\$6\$(?:rounds=[0-9]{4,9}\$)?[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}"
    yescrypt = r"\$y\$[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{1,86}\$[./A-Za-z0-9]{43}"
    if not re.fullmatch(f"(?:{sha512}|{yescrypt})", value):
        raise ProvisionError("Console credential must be a supported nonempty password hash")
    if value.startswith("$6$rounds=") and not 1000 <= int(value.split("$", 3)[2].split("=", 1)[1]) <= 1000000:
        raise ProvisionError("Unsupported console password work factor")
    # Ask the target's libxcrypt to parse the setting using a non-secret probe.
    # This neither knows nor checks the actual passphrase, but rejects settings
    # that would otherwise be stored successfully and leave console login broken.
    library = None
    for name in ("libcrypt.so.2", "libcrypt.so.1"):
        try:
            library = ctypes.CDLL(name)
            break
        except OSError:
            pass
    if library is None:
        raise ProvisionError("System password hash validation is unavailable")
    library.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    library.crypt.restype = ctypes.c_char_p
    probe = library.crypt(b"personal-os-format-check", value.encode())
    if not probe or probe.startswith(b"*"):
        raise ProvisionError("System does not support the console password hash setting")
    return value


class Backend:
    @staticmethod
    def lookup(kind, value):
        functions = {"user": pwd.getpwnam, "uid": pwd.getpwuid,
                     "group": grp.getgrnam, "gid": grp.getgrgid}
        try:
            return functions[kind](value)
        except KeyError:
            return None

    @staticmethod
    def hostname():
        return socket.gethostname()

    @staticmethod
    def ids(kind):
        return ([entry.pw_uid for entry in pwd.getpwall()] if kind == "subuid"
                else [entry.gr_gid for entry in grp.getgrall()])

    @staticmethod
    def run(args, input=None):
        result = subprocess.run(args, input=input, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=30)
        if result.returncode:
            raise ProvisionError("Account provisioning command failed: " + args[0])


def rename_exclusive(parent, source, destination):
    # Linux renameat2 avoids both overwrite races and the transient second hard
    # link that could make a power-loss retry ambiguous.
    rename = ctypes.CDLL(None, use_errno=True).renameat2
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    if rename(parent, os.fsencode(source), parent, os.fsencode(destination), 1):
        raise OSError(ctypes.get_errno(), "Atomic provisioning file installation failed")


class Files:
    """Descriptor-relative access: no symlink parents, recursive chown or resets."""
    def __init__(self, root, config, privileged_uid=0, privileged_gid=0):
        self.root = root
        self.config = config
        self.privileged = (privileged_uid, privileged_gid)

    def owner(self, path):
        parts = Path(path).parts
        if len(parts) >= 2 and parts[:2] == ("home", self.config["username"]):
            return self.config["uid"], self.config["gid"]
        return self.privileged

    @contextmanager
    def directory(self, path, create=False):
        fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        current = Path()
        try:
            info = os.fstat(fd)
            if (info.st_uid, info.st_gid) != self.privileged or info.st_mode & 0o022:
                raise ProvisionError("Unsafe provisioning root directory")
            for part in Path(path).parts:
                if part in ("..", "/"):
                    raise ProvisionError("Unsafe provisioning path")
                current /= part
                owner = self.owner(current)
                try:
                    child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                except FileNotFoundError:
                    if not create:
                        raise
                    os.mkdir(part, 0o700, dir_fd=fd)
                    child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                    os.fchown(child, *owner)
                os.close(fd)
                fd = child
                info = os.fstat(fd)
                if (info.st_uid, info.st_gid) != owner or info.st_mode & 0o022:
                    raise ProvisionError("Unsafe directory ownership or permissions")
            yield fd
        finally:
            os.close(fd)

    def read(self, path, private=True, allow_hardlinks=False):
        with self.directory(Path(path).parent) as parent:
            try:
                fd = os.open(Path(path).name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
            except FileNotFoundError:
                return None
            with os.fdopen(fd, "rb") as stream:
                info = os.fstat(stream.fileno())
                if not stat.S_ISREG(info.st_mode) or (info.st_nlink != 1 and not allow_hardlinks) or (info.st_uid, info.st_gid) != self.owner(path) or info.st_mode & (0o077 if private else 0o022):
                    raise ProvisionError("Unsafe provisioning file")
                data = stream.read(65537)
                if len(data) > 65536:
                    raise ProvisionError("Provisioning file too large")
                return data

    def write(self, path, data, mode=0o600, replace=False):
        with self.directory(Path(path).parent, create=True) as parent:
            name = Path(path).name
            temporary = ".personal-os-" + secrets.token_hex(12)
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=parent)
            try:
                with os.fdopen(fd, "wb") as stream:
                    os.fchown(stream.fileno(), *self.owner(path))
                    os.fchmod(stream.fileno(), mode)
                    stream.write(data)
                    stream.flush()
                    os.fsync(stream.fileno())
                if replace:
                    os.rename(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
                else:
                    rename_exclusive(parent, temporary, name)
                os.fsync(parent)
            finally:
                try:
                    os.unlink(temporary, dir_fd=parent)
                except FileNotFoundError:
                    pass


SUBID_MIN = 100000
SUBID_COUNT = 65536
SUBID_MAX = 2**32 - 2  # uid_t's all-ones value is reserved.


def subid_entries(data):
    entries = []
    for line in (data or b"").decode("ascii").splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        parts = line.split(":")
        if (len(parts) != 3 or not re.fullmatch(r"[A-Za-z0-9_.-]+\$?", parts[0])
                or any(not re.fullmatch(r"[0-9]{1,10}", p) for p in parts[1:])):
            raise ProvisionError("Invalid subordinate ID database")
        owner, start, count = parts[0], int(parts[1]), int(parts[2])
        if owner.isdecimal():
            if int(owner) > SUBID_MAX:
                raise ProvisionError("Invalid subordinate ID owner")
            owner = str(int(owner))
        if count < 1 or start + count - 1 > SUBID_MAX:
            raise ProvisionError("Invalid subordinate ID range")
        entries.append((owner, start, count))
    return entries


def require_local_subids(files):
    # Fedora authselect plus tmpfiles' factory links form a small known chain.
    # Validate every link/parent; do not follow arbitrary NSS links or plugins.
    path = "etc/nsswitch.conf"
    for _ in range(6):
        parent = str(Path(path).parent)
        if parent == "etc/authselect" and (files.root / parent).is_symlink():
            with files.directory("etc"):
                info = (files.root / parent).lstat()
                link = os.readlink(files.root / parent)
            if (info.st_uid, info.st_gid) != files.privileged or link not in (
                    "/usr/share/factory/etc/authselect", "../usr/share/factory/etc/authselect"):
                raise ProvisionError("Unrecognized NSS directory link")
            path = "usr/share/factory/etc/authselect/nsswitch.conf"
            continue
        with files.directory(parent):
            candidate = files.root / path
            if not candidate.is_symlink():
                break
            info = candidate.lstat()
            link = os.readlink(candidate)
        if (info.st_uid, info.st_gid) != files.privileged:
            raise ProvisionError("Untrusted NSS configuration link")
        if path == "etc/nsswitch.conf" and link in (
                "/usr/share/factory/etc/nsswitch.conf", "../usr/share/factory/etc/nsswitch.conf"):
            path = "usr/share/factory/etc/nsswitch.conf"
        elif path in ("etc/nsswitch.conf", "usr/share/factory/etc/nsswitch.conf") and link in (
                "/etc/authselect/nsswitch.conf", "authselect/nsswitch.conf"):
            path = ("usr/share/factory/etc/authselect/nsswitch.conf" if path.startswith("usr/")
                    else "etc/authselect/nsswitch.conf")
        else:
            raise ProvisionError("Unrecognized NSS configuration link")
    else:
        raise ProvisionError("NSS configuration link loop")
    # Read-only distro config can be hardlink-deduplicated; mutable databases,
    # journals and secret inputs retain the stricter single-link requirement.
    data = files.read(path, private=False, allow_hardlinks=True)
    sources = [line.split(":", 1)[1].split("#", 1)[0].strip()
               for line in (data or b"").decode("ascii").splitlines()
               if re.match(r"^\s*subid\s*:", line)]
    if sources not in ([], ["files"]):
        raise ProvisionError("Rootless enrollment requires local files subid delegation")


@contextmanager
def subid_locks(files):
    # Shadow's commonio uses exclusive <database>.lock files containing a PID.
    # Cooperate with native writers, not merely another private flock. Never
    # steal a live/ambiguous lock; only well-formed, root-owned dead-PID locks
    # can be recovered after a crash. Enrollment runs in the host PID namespace.
    with files.directory("etc") as parent:
        held = []
        try:
            for name in ("subuid.lock", "subgid.lock"):
                try:
                    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                 0o600, dir_fd=parent)
                except FileExistsError:
                    data = files.read("etc/" + name, private=False)
                    if data is None or not re.fullmatch(rb"[1-9][0-9]{0,9}[\n\x00]?", data):
                        raise ProvisionError("Ambiguous subordinate ID database lock") from None
                    pid = int(data.rstrip(b"\n\x00"))
                    if pid > 2147483647:
                        raise ProvisionError("Invalid subordinate ID database lock PID")
                    try:
                        os.kill(pid, 0)
                    except ProcessLookupError:
                        os.unlink(name, dir_fd=parent)
                    except PermissionError:
                        raise ProvisionError("Subordinate ID database locked; retry") from None
                    else:
                        raise ProvisionError("Subordinate ID database locked; retry")
                    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                 0o600, dir_fd=parent)
                with os.fdopen(fd, "wb") as stream:
                    os.fchown(stream.fileno(), *files.privileged)
                    held.append((name, os.fstat(stream.fileno()).st_ino))
                    stream.write(f"{os.getpid()}\n".encode())
                    stream.flush()
                    os.fsync(stream.fileno())
            yield
        finally:
            for name, inode in reversed(held):
                if os.stat(name, dir_fd=parent, follow_symlinks=False).st_ino == inode:
                    os.unlink(name, dir_fd=parent)
            os.fsync(parent)


def subid_plan(files, backend, allow_existing, recorded=None):
    tables, own, blocked = {}, {}, []
    owners = {files.config["username"], str(files.config["uid"])}
    for kind in ("subuid", "subgid"):
        data = files.read("etc/" + kind, private=False)
        entries = subid_entries(data)
        tables[kind] = (data, entries)
        own[kind] = [(start, count) for owner, start, count in entries if owner in owners]
        if own[kind] and (not allow_existing or len(own[kind]) != 1
                          or own[kind][0][0] < SUBID_MIN or own[kind][0][1] < SUBID_COUNT):
            raise ProvisionError("Existing subordinate IDs require operator review")
        blocked.extend((start, start + count) for _, start, count in entries)
        blocked.extend((value, value + 1) for value in backend.ids(kind))
    start = SUBID_MIN
    if recorded is None and any(not entries for entries in own.values()):
        for first, end in sorted(blocked):
            if first >= start + SUBID_COUNT:
                break
            if end > start:
                start = end
        if start + SUBID_COUNT - 1 > SUBID_MAX:
            raise ProvisionError("No free subordinate ID block")
    ranges = (recorded if recorded is not None else
              {kind: list(own[kind][0]) if own[kind] else [start, SUBID_COUNT]
               for kind in tables})
    return tables, own, ranges


def rootless_enrollment(files, backend, allow_existing=False):
    path = "var/lib/personal-os/rootless.json"
    require_local_subids(files)
    with subid_locks(files):
        data = files.read(path)
        try:
            state = json.loads(data) if data else None
        except ValueError:
            raise ProvisionError("Invalid rootless enrollment journal") from None
        identity = {key: files.config[key] for key in ("username", "uid", "gid")}
        recorded = None
        if state is not None:
            if (not isinstance(state, dict) or set(state) != {"version", "phase", "subuid", "subgid", "linger_on_enrollment", *identity}
                    or type(state["version"]) is not int or state["version"] != 1
                    or state["phase"] not in ("pending", "complete")
                    or any(type(state[key]) is not type(value) or state[key] != value for key, value in identity.items())
                    or state["linger_on_enrollment"] is not True):
                raise ProvisionError("Invalid rootless enrollment journal")
            recorded = {kind: state[kind] for kind in ("subuid", "subgid")}
        tables, own, ranges = subid_plan(files, backend, allow_existing or state is not None, recorded)
        for kind, expected in ranges.items():
            if (not isinstance(expected, list) or len(expected) != 2
                    or any(type(n) is not int for n in expected)
                    or expected[0] < SUBID_MIN or expected[1] < SUBID_COUNT
                    or sum(expected) - 1 > SUBID_MAX):
                raise ProvisionError("Invalid recorded subordinate IDs")
            if own[kind] and list(own[kind][0]) != expected:
                raise ProvisionError("Subordinate IDs changed; never remap container state")
            first, count = expected
            foreign = [(s, s + c) for owner, s, c in tables[kind][1]
                       if owner not in {identity["username"], str(identity["uid"])}]
            foreign.extend((value, value + 1) for value in backend.ids(kind))
            if any(first < end and other < first + count for other, end in foreign):
                raise ProvisionError("Subordinate IDs overlap an existing identity/range")
            if state and state["phase"] == "complete" and not own[kind]:
                raise ProvisionError("Recorded subordinate IDs missing; operator review required")
        if state and state["phase"] == "complete":
            # Lingering is initialized once. Preserve later loginctl disable-linger.
            return
        if state is None:
            state = {"version": 1, "phase": "pending", **identity, **ranges,
                     "linger_on_enrollment": True}
            files.write(path, (json.dumps(state) + "\n").encode())
        for kind, (first, count) in ranges.items():
            if not own[kind]:
                original = tables[kind][0]
                prefix = (original or b"") + (b"\n" if original and not original.endswith(b"\n") else b"")
                files.write("etc/" + kind, prefix + f"{identity['username']}:{first}:{count}\n".encode(),
                            mode=0o644, replace=original is not None)
        backend.run(["restorecon", str(files.root / "etc/subuid"), str(files.root / "etc/subgid"),
                     str(files.root / path)])
        marker = "var/lib/systemd/linger/" + identity["username"]
        try:
            existing = files.read(marker, private=False)
        except FileNotFoundError:
            existing = None
        if existing is None:
            backend.run(["loginctl", "enable-linger", identity["username"]])
            existing = files.read(marker, private=False)
        if existing != b"":
            raise ProvisionError("Lingering initialization failed or marker is unsafe")
        state["phase"] = "complete"
        files.write(path, (json.dumps(state) + "\n").encode(), replace=True)


def provision(root, config_data, password_data, backend, privileged_uid=0, privileged_gid=0):
    state_path = "var/lib/personal-os/account.json"
    # Read trusted state with a temporary config that cannot select a home path.
    files = Files(root, {"username": "", "uid": 0, "gid": 0}, privileged_uid, privileged_gid)
    with files.directory("var/lib/personal-os", create=True):
        pass
    state_data = files.read(state_path)
    state = None
    if state_data:
        try:
            state = json.loads(state_data)
            if set(state) != {"version", "phase", "config"} or type(state["version"]) is not int or state["version"] != 1 or state["phase"] not in ("pending", "complete"):
                raise ValueError()
            recorded = config_from_json(json.dumps(state["config"]))
        except (ValueError, TypeError):
            raise ProvisionError("Invalid account enrollment journal") from None
    if config_data is None:
        if state is None:
            raise ProvisionError("Missing account configuration credential")
        config = recorded
    else:
        config = config_from_json(config_data)
        if state and config != recorded:
            raise ProvisionError("Account configuration changed; operator review required")
    files = Files(root, config, privileged_uid, privileged_gid)
    name, uid, gid = config["username"], config["uid"], config["gid"]
    home = "home/" + name
    user = backend.lookup("user", name)
    uid_user = backend.lookup("uid", uid)
    group = backend.lookup("group", name)
    gid_group = backend.lookup("gid", gid)
    if uid_user and uid_user.pw_name != name or gid_group and gid_group.gr_name != name:
        raise ProvisionError("Account numeric identity is already in use")
    if user and (user.pw_uid, user.pw_gid, user.pw_dir, user.pw_shell) != (uid, gid, "/" + home, config["shell"]):
        raise ProvisionError("Existing account identity conflicts with enrollment")
    if group and group.gr_gid != gid:
        raise ProvisionError("Existing primary group conflicts with enrollment")
    if state is None and (user or group):
        raise ProvisionError("Refusing to adopt an existing account or group")
    wheel = backend.lookup("group", "wheel")
    if wheel is None:
        raise ProvisionError("Required wheel group is missing")
    sudo_path = "etc/sudoers.d/90-personal-os-account"
    sudo = (f"{name} ALL=(ALL:ALL) NOPASSWD: ALL\n" if config["passwordless_sudo"] else "").encode()
    keys_path = home + "/.ssh/authorized_keys"
    keys = ("\n".join(config["ssh_public_keys"]) + "\n").encode()

    if state and state["phase"] == "complete":
        if user is None or group is None or name not in wheel.gr_mem:
            raise ProvisionError("Enrolled account is incomplete; operator review required")
        with files.directory(home + "/.ssh"):
            pass
        if files.read(keys_path) is None or files.read(sudo_path, private=False) != sudo or backend.hostname() != config["hostname"]:
            raise ProvisionError("Enrolled access policy or hostname needs operator review")
        # Deliberately do not reset the password, keys, shell, groups or home.
        rootless_enrollment(files, backend, allow_existing=True)
        return config

    password = password_from_bytes(password_data or b"")
    # All existing mutable files must agree before account commands run. Missing
    # files are created atomically; divergent data is never overwritten.
    for path, expected in ((keys_path, keys), (sudo_path, sudo)):
        try:
            existing = files.read(path, private=path != sudo_path)
        except FileNotFoundError:
            existing = None
        if existing is not None and existing != expected:
            raise ProvisionError("Existing access-policy file conflicts with enrollment")
    if state is None:
        require_local_subids(files)
        with subid_locks(files):
            subid_plan(files, backend, allow_existing=False)
        state = {"version": 1, "phase": "pending", "config": config}
        files.write(state_path, (json.dumps(state) + "\n").encode())
    if group is None:
        backend.run(["groupadd", "--gid", str(gid), name])
    if user is None:
        backend.run(["useradd", "--no-create-home", "--no-user-group", "--no-log-init",
                     "--key", "SUB_UID_COUNT=0", "--key", "SUB_GID_COUNT=0",
                     "--uid", str(uid), "--gid", str(gid), "--home-dir", "/" + home,
                     "--shell", config["shell"], name])
    if name not in wheel.gr_mem:
        backend.run(["usermod", "--append", "--groups", "wheel", name])
    with files.directory(home + "/.ssh", create=True):
        pass
    if files.read(keys_path) is None:
        files.write(keys_path, keys)
    with files.directory("etc/sudoers.d", create=True):
        pass
    if files.read(sudo_path, private=False) is None:
        files.write(sudo_path, sudo, mode=0o440)
    backend.run(["visudo", "--check", "--file", str(root / sudo_path)])
    backend.run(["hostnamectl", "set-hostname", config["hostname"]])
    backend.run(["restorecon", str(root / home), str(root / (home + "/.ssh")),
                 str(root / keys_path), str(root / sudo_path), str(root / state_path)])
    shadow = files.read("etc/shadow")
    hashes = [line.split(b":")[1] for line in (shadow or b"").splitlines()
              if line.split(b":", 1)[0] == name.encode() and b":" in line]
    if len(hashes) != 1:
        raise ProvisionError("Account shadow entry is missing or ambiguous")
    current = hashes[0].decode("ascii")
    if current != password:
        if current not in ("!", "!!", "*"):
            raise ProvisionError("Existing console password differs; operator review required")
        backend.run(["chpasswd", "--encrypted"], input=(name + ":" + password + "\n").encode())
    # Rootless mappings/linger must succeed before publishing account readiness.
    # A separate ledger preserves the original account journal's rollback schema.
    rootless_enrollment(files, backend)
    # The final journal carries no password/hash; successful boots require no
    # original credentials and never replay secret enrollment.
    state["phase"] = "complete"
    files.write(state_path, (json.dumps(state) + "\n").encode(), replace=True)
    return config


def publish_context(root, config, privileged_uid=0, privileged_gid=0):
    """Non-secret, runtime-only identity for the unprivileged lifecycle helper."""
    files = Files(root, config, privileged_uid, privileged_gid)
    path = "run/personal-os/account-context.json"
    with files.directory("run/personal-os", create=True):
        pass
    context = {"version": 1, **{key: config[key] for key in ("username", "uid", "gid", "hostname")}}
    data = (json.dumps(context, sort_keys=True) + "\n").encode()
    existing = files.read(path, private=False)
    if existing is not None and existing != data:
        raise ProvisionError("Runtime account context differs; operator review required")
    if existing is None:
        files.write(path, data, mode=0o644)


def main():
    try:
        if os.geteuid() != 0 or not Path("/usr/lib/personal-os/account-provisioning").is_file():
            raise ProvisionError("Account provisioning is restricted to the target profile")
        os.environ["PATH"] = "/usr/sbin:/usr/bin"
        directory = os.environ.get("CREDENTIALS_DIRECTORY")
        config_data = password_data = None
        if directory and Path(directory).exists():
            credentials = Files(Path(directory), {"username": "", "uid": 0, "gid": 0})
            config_data = credentials.read("personal-os.account.json")
            password_data = credentials.read("personal-os.console-password.hash")
        config = provision(Path("/"), config_data, password_data, Backend())
        publish_context(Path("/"), config)
    except ProvisionError as error:
        # These messages contain only controlled field/reason/command names,
        # never input values, subprocess stderr or secret-bearing exception reprs.
        print("personal-os account enrollment failed: " + str(error), file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError, UnicodeError, ValueError):
        print("personal-os account enrollment failed: protected filesystem or command execution error", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
