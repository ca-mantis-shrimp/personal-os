#!/usr/bin/python3
"""Target-user chezmoi lifecycle prototype; never grants workload readiness.

Source promotion is a conservative three-way comparison, not a template renderer.
Chezmoi alone initializes/renders/applies the intended user's configuration.
"""
import base64
from collections import namedtuple
import hashlib
import fcntl
import json
import os
from pathlib import Path, PurePosixPath
import platform
import posixpath
import pwd
import re
import secrets
import socket
import stat
import subprocess
import sys

Node = namedtuple("Node", "kind mode data attrs")
REVISION = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})")
MAX_FILE = 8 * 1024 * 1024
MAX_STATE = 32 * 1024 * 1024
STATE_PATH = ".local/state/personal-os/chezmoi.json"
SOURCE_PATH = ".local/share/chezmoi"
CONFIG_PATH = ".config/chezmoi/chezmoi.toml"
NEXT_CONFIG = ".local/state/personal-os/chezmoi-next.toml"


class LifecycleError(Exception):
    pass


def relative(name):
    if not isinstance(name, str) or not name or "\0" in name:
        raise LifecycleError("Invalid lifecycle path")
    path = PurePosixPath(name)
    if not path.parts or path.is_absolute() or str(path) != name or any(part in ("..", ".git") for part in path.parts):
        raise LifecycleError("Invalid lifecycle path")
    return path


def digest(data):
    return hashlib.sha256(data).hexdigest()


def json_bytes(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def directories(path, create=False, owner=None):
    """No symlink parents. Only create beneath an already validated user home."""
    missing = []
    current = path
    while not current.exists() and not current.is_symlink():
        missing.append(current)
        current = current.parent
    for directory in [current, *reversed(missing)]:
        if directory in missing:
            if not create:
                return False
            directory.mkdir(mode=0o700)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022 or owner is not None and info.st_uid != owner:
            raise LifecycleError("Unsafe lifecycle directory")
    return True


class Home:
    def __init__(self, root):
        self.root = root
        info = root.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise LifecycleError("Home is not a safe user-owned directory")

    def path(self, name, create_parents=False):
        parts = relative(name).parts
        current = self.root
        for part in parts[:-1]:
            current /= part
            if not directories(current, create=create_parents, owner=os.geteuid()):
                return None
        return self.root.joinpath(*parts)

    def node(self, name, limit=MAX_FILE):
        path = self.path(name)
        if path is None:
            return None
        try:
            info = path.lstat()
        except FileNotFoundError:
            return None
        if info.st_uid != os.geteuid():
            raise LifecycleError("Lifecycle file has unexpected ownership")
        if stat.S_ISLNK(info.st_mode):
            return Node("link", 0o777, os.fsencode(os.readlink(path)), ())
        if stat.S_ISDIR(info.st_mode):
            return Node("dir", stat.S_IMODE(info.st_mode), b"", ())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise LifecycleError("Unsupported lifecycle file")
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            data = stream.read(limit + 1)
        if len(data) > limit:
            raise LifecycleError("Lifecycle file is too large")
        # SELinux labels naturally differ between immutable /usr and mutable home.
        # Other attributes/ACLs are local edits, not disposable metadata.
        attrs = tuple((key, os.getxattr(path, key, follow_symlinks=False))
                      for key in sorted(os.listxattr(path, follow_symlinks=False))
                      if key != "security.selinux")
        return Node("file", stat.S_IMODE(info.st_mode), data, attrs)

    def private(self, name):
        node = self.node(name, MAX_STATE)
        if node is not None and (node.kind != "file" or node.mode & 0o077):
            raise LifecycleError("Lifecycle state/configuration is not private")
        return node

    def put(self, name, node):
        path = self.path(name, create_parents=True)
        if node is None:
            if path.exists() or path.is_symlink():
                path.unlink()  # Never recursive deletion.
            parent = path.parent
            while parent != self.root / SOURCE_PATH and parent.is_relative_to(self.root / SOURCE_PATH):
                try:
                    parent.rmdir()  # Preserve directories containing local files.
                except OSError:
                    break
                parent = parent.parent
            return
        temporary = path.parent / (".personal-os-" + secrets.token_hex(12))
        try:
            if node.kind == "link":
                temporary.symlink_to(os.fsdecode(node.data))
            elif node.kind == "file":
                fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, "wb") as stream:
                    os.fchmod(stream.fileno(), node.mode)
                    stream.write(node.data)
                    stream.flush()
                    os.fsync(stream.fileno())
            else:
                raise LifecycleError("Unsupported lifecycle write")
            os.replace(temporary, path)
            fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        finally:
            temporary.unlink(missing_ok=True)

    def save(self, state):
        self.put(STATE_PATH, Node("file", 0o600, json_bytes(state), ()))


def factory_payload(factory):
    revision = (factory / "revision").read_text().strip()
    policy = json.loads((factory / "policy.json").read_bytes())
    manifest = json.loads((factory / "manifest.json").read_bytes())
    if not REVISION.fullmatch(revision) or not isinstance(policy, dict) or set(policy) != {"version", "revision", "approved_predecessors"}:
        raise LifecycleError("Invalid factory policy")
    if type(policy["version"]) is not int or policy["version"] != 1 or policy["revision"] != revision:
        raise LifecycleError("Unsupported factory policy")
    predecessors = policy["approved_predecessors"]
    if not isinstance(predecessors, list) or len(predecessors) > 256 or any(not isinstance(pin, str) or not REVISION.fullmatch(pin) for pin in predecessors):
        raise LifecycleError("Invalid factory predecessor policy")
    if not isinstance(manifest, list) or not 1 <= len(manifest) <= 4096:
        raise LifecycleError("Invalid factory manifest")
    nodes = {}
    canonical = []
    for entry in manifest:
        if not isinstance(entry, dict) or set(entry) != {"path", "mode", "sha256"}:
            raise LifecycleError("Invalid factory entry")
        name = str(relative(entry["path"]))
        if name in nodes or entry["mode"] not in {"100644", "100755", "120000"}:
            raise LifecycleError("Unsupported factory entry")
        path = factory / "source" / name
        for parent in path.parents:
            if parent == factory:
                break
            if parent.is_symlink():
                raise LifecycleError("Factory has a symlink parent")
        info = path.lstat()
        if entry["mode"] == "120000" and stat.S_ISLNK(info.st_mode):
            node = Node("link", 0o777, os.fsencode(os.readlink(path)), ())
        elif entry["mode"] != "120000" and stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
            with path.open("rb") as stream:
                data = stream.read(MAX_FILE + 1)
            node = Node("file", 0o755 if entry["mode"] == "100755" else 0o644, data, ())
        else:
            raise LifecycleError("Factory entry type mismatch")
        if node.kind == "file" and stat.S_IMODE(info.st_mode) != node.mode:
            raise LifecycleError("Factory entry permission mismatch")
        if len(node.data) > MAX_FILE or digest(node.data) != entry["sha256"]:
            raise LifecycleError("Factory payload integrity check failed")
        nodes[name] = node
        canonical.append(entry)
    regular = {name for name, node in nodes.items() if node.kind == "file"}
    for name, node in nodes.items():
        if node.kind == "link":
            link = os.fsdecode(node.data)
            target = posixpath.normpath(posixpath.join(posixpath.dirname(name), link))
            if link.startswith("/") or target not in regular:
                raise LifecycleError("Factory source link escapes the reviewed payload")
    actual = set()
    for parent, dirs, files in os.walk(factory / "source", followlinks=False):
        for name in [*dirs, *files]:
            path = Path(parent) / name
            if path.is_symlink() or path.is_file():
                actual.add(path.relative_to(factory / "source").as_posix())
    if actual != set(nodes):
        raise LifecycleError("Factory has unmanifested entries")
    fingerprint = digest(json_bytes(sorted(canonical, key=lambda entry: entry["path"])))
    return revision, fingerprint, predecessors, nodes


def encode_nodes(nodes):
    return {name: [node.kind, node.mode, base64.b64encode(node.data).decode()] for name, node in nodes.items()}


def decode_nodes(value):
    if not isinstance(value, dict) or len(value) > 4096:
        raise LifecycleError("Invalid source baseline")
    result = {}
    for name, record in value.items():
        relative(name)
        if not isinstance(record, list) or len(record) != 3 or record[0] not in ("file", "link") or type(record[1]) is not int:
            raise LifecycleError("Invalid source baseline")
        data = base64.b64decode(record[2], validate=True)
        if len(data) > MAX_FILE or (record[0] == "file" and record[1] not in (0o644, 0o755)) or (record[0] == "link" and record[1] != 0o777):
            raise LifecycleError("Invalid source baseline")
        result[name] = Node(record[0], record[1], data, ())
    return result


def load_state(home):
    node = home.private(STATE_PATH)
    if node is None:
        return None
    state = json.loads(node.data)
    fields = {"version", "source_revision", "payload_digest", "base", "phase", "applied_revision",
              "applied_context", "config_digest", "template_digest", "config_context"}
    if not isinstance(state, dict) or set(state) != fields or type(state["version"]) is not int or state["version"] != 1:
        raise LifecycleError("Unsupported lifecycle state; refusing downgrade or adoption")
    if state["phase"] not in ("preparing", "applying", "complete"):
        raise LifecycleError("Invalid lifecycle phase")
    for key in ("source_revision", "applied_revision"):
        if state[key] is not None and (not isinstance(state[key], str) or not REVISION.fullmatch(state[key])):
            raise LifecycleError("Invalid lifecycle revision")
    base = decode_nodes(state["base"])
    for key in ("payload_digest", "config_digest", "template_digest"):
        value = state[key]
        if value is not None and (not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value)):
            raise LifecycleError("Invalid lifecycle digest")
    if state["phase"] == "preparing":
        if state["source_revision"] is not None or state["payload_digest"] is not None or base:
            raise LifecycleError("Invalid preparing state")
    elif not base or state["source_revision"] is None or state["payload_digest"] is None:
        raise LifecycleError("Invalid promoted source state")
    if state["phase"] == "complete" and state["applied_revision"] != state["source_revision"]:
        raise LifecycleError("Invalid completed lifecycle state")
    return state


def source_plan(home, base, new):
    plan = []
    for name in sorted(set(base) | set(new)):
        old, desired = base.get(name), new.get(name)
        current = home.node(SOURCE_PATH + "/" + name)
        if current == desired or desired == old:
            continue  # Includes user-edited/deleted files with unchanged upstream.
        if current != old:
            raise LifecycleError("Source has conflicting local edits; review required")
        plan.append((name, desired, current))
    return plan


def configure(root, factory, backend, context):
    home = Home(root)
    lock = home.path(".local/state/personal-os/chezmoi.lock", create_parents=True)
    home.private(".local/state/personal-os/chezmoi.lock")
    fd = os.open(lock, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise LifecycleError("Unsafe lifecycle lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise LifecycleError("Another configuration attempt is running") from None
        return configure_locked(root, factory, backend, context)
    finally:
        os.close(fd)


def configure_locked(root, factory, backend, context):
    home = Home(root)
    revision, fingerprint, predecessors, new = factory_payload(factory)
    state = load_state(home)
    source = root / SOURCE_PATH
    if state and state["source_revision"] == revision and state["payload_digest"] != fingerprint:
        raise LifecycleError("Factory payload changed without a new dotfiles pin")
    if state and state["source_revision"] not in (None, revision) and state["source_revision"] not in predecessors:
        raise LifecycleError("Older or unrelated factory source refused; independent recovery/review required")
    if state and state["phase"] == "complete" and state["applied_revision"] == revision and state["applied_context"] == context:
        return "unchanged"  # Do not apply over home/config edits on every boot.
    backend.confirm_stopped()
    if state is None:
        if source.exists() or source.is_symlink():
            raise LifecycleError("Existing writable source requires explicit adoption review")
        state = {"version": 1, "source_revision": None, "payload_digest": None, "base": {},
                 "phase": "preparing", "applied_revision": None, "applied_context": None,
                 "config_digest": None, "template_digest": None, "config_context": None}
        home.save(state)  # Before creating source, so interrupted setup can retry.
    base = decode_nodes(state["base"])
    plan = source_plan(home, base, new)  # Preflight ALL paths before any promotion.
    for name, node, expected in sorted(plan, key=lambda item: (item[1] is not None, -len(PurePosixPath(item[0]).parts))):
        if home.node(SOURCE_PATH + "/" + name) != expected:
            raise LifecycleError("Source changed during promotion; retry/review required")
        home.put(SOURCE_PATH + "/" + name, node)
    state.update(source_revision=revision, payload_digest=fingerprint, base=encode_nodes(new), phase="applying")
    home.save(state)
    home.path(SOURCE_PATH + "/.git-placeholder")  # Validate source parent without traversing .git.
    if (source / ".git").is_symlink():
        raise LifecycleError("Source Git metadata must not be a symlink")
    if not (source / ".git").exists():
        if state["applied_revision"] is not None:
            raise LifecycleError("Established source Git metadata was removed; review required")
        backend.initialize_repo(source)
    else:
        info = (source / ".git").lstat()
        if info.st_uid != os.geteuid() or info.st_mode & 0o022 or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            raise LifecycleError("Unsafe source Git metadata")
    template = home.node(SOURCE_PATH + "/.chezmoi.toml.tmpl")
    if template is None or template.kind != "file":
        raise LifecycleError("Source config template is missing or not a regular file")
    template_hash = digest(template.data)
    config = home.private(CONFIG_PATH)
    for name in (".local/state/chezmoi", ".cache/chezmoi"):
        home.path(name + "/.placeholder", create_parents=True)
    if template_hash != state["template_digest"] or context != state["config_context"]:
        home.path(NEXT_CONFIG, create_parents=True)
        home.private(NEXT_CONFIG)  # Reject a symlink/unsafe leftover before native init.
        backend.init(root / NEXT_CONFIG)
        candidate = home.private(NEXT_CONFIG)
        if candidate is None:
            raise LifecycleError("Chezmoi init did not produce a private configuration")
        if config is not None and config.data != candidate.data and digest(config.data) != state["config_digest"]:
            raise LifecycleError("Generated config conflicts with local edits; candidate retained for review")
        if config != candidate:
            if config is not None and (config.mode != 0o600 or config.attrs):
                raise LifecycleError("Generated config has local metadata edits; review required")
            home.put(CONFIG_PATH, candidate)
        state.update(config_digest=digest(candidate.data), template_digest=template_hash, config_context=context)
        home.save(state)
        home.put(NEXT_CONFIG, None)
    elif config is None:
        raise LifecycleError("Previously initialized configuration was removed; review required")
    backend.apply(dry_run=True)
    backend.apply(dry_run=False)
    state.update(phase="complete", applied_revision=revision, applied_context=context)
    home.save(state)  # Never write an applied revision before full apply succeeds.
    return "applied"


class Backend:
    def __init__(self, home, username, uid):
        self.home, self.username, self.uid = home, username, uid
        self.env = {"PATH": "/usr/sbin:/usr/bin", "HOME": str(home), "USER": username,
                    "LOGNAME": username, "LANG": "C.UTF-8", "CHEZMOI_IMMUTABLE": "1",
                    # Backward-compatible package-hook guard, not fake template identity.
                    "CHEZMOI_CONTAINER": "1", "XDG_CONFIG_HOME": str(home / ".config"),
                    "XDG_DATA_HOME": str(home / ".local/share"), "XDG_STATE_HOME": str(home / ".local/state"),
                    "XDG_CACHE_HOME": str(home / ".cache"), "XDG_RUNTIME_DIR": f"/run/user/{uid}",
                    "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{uid}/bus"}
        # If explicitly provisioned to this target-user process, do not persist/log it.
        if "OP_SERVICE_ACCOUNT_TOKEN" in os.environ:
            self.env["OP_SERVICE_ACCOUNT_TOKEN"] = os.environ["OP_SERVICE_ACCOUNT_TOKEN"]

    def run(self, args):
        result = subprocess.run(args, env=self.env, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=300)
        if result.returncode:
            raise LifecycleError("Target configuration command failed; raw output suppressed")
        return result.stdout

    def confirm_stopped(self):
        if Path("/run/personal-os/chezmoi-ready").exists():
            raise LifecycleError("Readiness must be revoked before applying configuration")
        for unit in ("radicale.service", f"syncthing@{self.username}.service"):
            if self.run(["systemctl", "--system", "show", "--property=ActiveState", "--value", unit]).strip() not in (b"inactive", b"failed"):
                raise LifecycleError("System workloads must be stopped before configuration")
        manager = self.run(["systemctl", "--system", "show", "--property=ActiveState", "--value", f"user@{self.uid}.service"]).strip()
        if manager == b"active":
            for unit in ("otelcol.service", "neovim-server.service", "syncthing.service", "vdirsyncer.service", "vdirsyncer.timer"):
                if self.run(["systemctl", "--user", "show", "--property=ActiveState", "--value", unit]).strip() not in (b"inactive", b"failed"):
                    raise LifecycleError("User workloads must be stopped before configuration")
        elif manager not in (b"inactive", b"failed"):
            raise LifecycleError("User manager is transitioning; retry later")

    def initialize_repo(self, source):
        self.run(["git", "-c", "core.hooksPath=/dev/null", "init", "--", str(source)])

    def command(self):
        return ["chezmoi", "--source", str(self.home / SOURCE_PATH), "--destination", str(self.home),
                "--config", str(self.home / CONFIG_PATH), "--persistent-state", str(self.home / ".local/state/chezmoi/chezmoi.boltdb"),
                "--cache", str(self.home / ".cache/chezmoi"), "--no-tty", "--no-pager", "--force=false",
                "--interactive=false", "--less-interactive", "--error-on-conflict", "--keep-going=false",
                "--debug=false", "--verbose=false", "--color=false", "--progress=false"]

    def init(self, candidate):
        self.run(self.command() + ["init", "--config-path", str(candidate)])

    def apply(self, dry_run):
        self.run(self.command() + [f"--dry-run={'true' if dry_run else 'false'}", "apply"])


def enrolled_context(path=Path("/run/personal-os/account-context.json")):
    for parent in (path.parent, path.parent.parent):
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or (info.st_uid, info.st_gid) != (0, 0) or info.st_mode & 0o022:
            raise LifecycleError("Untrusted runtime account context directory")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or (info.st_uid, info.st_gid) != (0, 0) or info.st_mode & 0o022:
            raise LifecycleError("Untrusted runtime account context")
        data = stream.read(4097)
    if len(data) > 4096:
        raise LifecycleError("Invalid runtime account context")
    context = json.loads(data)
    if not isinstance(context, dict) or set(context) != {"version", "uid", "gid", "username", "hostname"} or type(context["version"]) is not int or context["version"] != 1:
        raise LifecycleError("Unsupported runtime account context")
    if type(context["uid"]) is not int or type(context["gid"]) is not int or not isinstance(context["username"], str) or not isinstance(context["hostname"], str):
        raise LifecycleError("Invalid runtime account context")
    return context


def main():
    try:
        if os.geteuid() < 1000 or not Path("/usr/lib/personal-os/account-provisioning").is_file():
            raise LifecycleError("Configuration is restricted to the target user/profile")
        if Path("/sys/fs/selinux/enforce").read_text().strip() != "1":
            raise LifecycleError("Target configuration requires enforcing SELinux")
        user = pwd.getpwuid(os.geteuid())
        enrolled = enrolled_context()
        if (user.pw_uid, user.pw_gid, user.pw_name, socket.gethostname()) != (enrolled["uid"], enrolled["gid"], enrolled["username"], enrolled["hostname"]):
            raise LifecycleError("Process identity does not match successful target enrollment")
        if user.pw_dir != "/home/" + user.pw_name or os.getegid() != user.pw_gid:
            raise LifecycleError("Target account/home/group do not match the provisioned context")
        backend = Backend(Path(user.pw_dir), user.pw_name, user.pw_uid)
        if backend.run(["systemctl", "--system", "show", "--property=ActiveState", "--value", "personal-os-account.service"]).strip() != b"active":
            raise LifecycleError("Account enrollment must be active before configuration")
        os.umask(0o077)
        context = {"uid": user.pw_uid, "gid": user.pw_gid, "username": user.pw_name,
                   "hostname": socket.gethostname(), "machine": platform.machine(), "kernel": platform.release(),
                   "os_release": Path("/usr/lib/os-release").read_text()}
        configure(Path(user.pw_dir), Path("/usr/share/personal-os/dotfiles"),
                  backend, context)
    except LifecycleError as error:
        print("personal-os configuration failed: " + str(error), file=sys.stderr)
        return 1
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        print("personal-os configuration failed: invalid state, protected path or command execution error", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
