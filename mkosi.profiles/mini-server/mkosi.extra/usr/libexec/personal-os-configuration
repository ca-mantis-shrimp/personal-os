#!/usr/bin/python3
"""Root-side configuration controller. Prototype: NEVER grants readiness.

Only its target systemd unit should drive apply/stop, so cancellation kills the
entire child cgroup before ExecStopPost cleanup. No builder-side execution.
"""
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import signal
import socket
import stat
import subprocess
import sys

USER_UNITS = ("vdirsyncer.timer", "vdirsyncer.service", "otelcol.service",
              "neovim-server.service", "syncthing.service")
STOPPED = (b"inactive", b"failed")


class ControlError(Exception):
    pass


def validate_context(value):
    if not isinstance(value, dict) or set(value) != {"version", "username", "uid", "gid", "hostname"} or type(value["version"]) is not int or value["version"] != 1:
        raise ControlError("Unsupported enrolled context")
    if not isinstance(value["username"], str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", value["username"]):
        raise ControlError("Invalid enrolled username")
    for key in ("uid", "gid"):
        if type(value[key]) is not int or not 1000 <= value[key] <= 60000:
            raise ControlError("Invalid enrolled numeric identity")
    if not isinstance(value["hostname"], str) or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", value["hostname"]):
        raise ControlError("Invalid enrolled hostname")
    return value


class Runtime:
    """Descriptor-relative, root-owned runtime access; no home writes as root."""
    def __init__(self, path=Path("/run/personal-os"), owner=(0, 0)):
        self.path, self.owner = path, owner  # owner override is for disposable tests only.

    def safe(self, info, private=False):
        return ((info.st_uid, info.st_gid) == self.owner and
                not info.st_mode & (0o077 if private else 0o022))

    def __enter__(self):
        self.directory = os.open(self.path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        self.lock = None
        try:
            if not self.safe(os.fstat(self.directory)):
                raise ControlError("Unsafe controller runtime directory")
            self.lock = os.open("configuration.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
                                0o600, dir_fd=self.directory)
            info = os.fstat(self.lock)
            if not self.safe(info, private=True) or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                raise ControlError("Unsafe controller lock")
            try:
                fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ControlError("Another controller is running; stop the unit before retrying") from None
            return self
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def __exit__(self, *_):
        if self.lock is not None:
            os.close(self.lock)
        os.close(self.directory)

    def revoke(self):
        try:
            # unlink also safely removes a bad symlink without following it.
            os.unlink("chezmoi-ready", dir_fd=self.directory)
        except FileNotFoundError:
            pass
        os.fsync(self.directory)

    def context(self):
        fd = os.open("account-context.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                     dir_fd=self.directory)
        with os.fdopen(fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            if not self.safe(info) or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                raise ControlError("Unsafe enrolled runtime context")
            data = stream.read(4097)
        if len(data) > 4096:
            raise ControlError("Enrolled context is too large")
        return validate_context(json.loads(data))


def control(runtime, backend, apply=True):
    runtime.revoke()  # Even malformed/missing identity must not leave readiness.
    context = runtime.context()
    backend.identity(context)
    try:
        backend.halt(context)
        if apply:
            backend.enrollment(context)
            backend.apply(context)
    finally:
        runtime.revoke()
        # Includes successful apply: reload/stop any newly installed user units.
        # A cleanup failure must fail the controller, not masquerade as success.
        backend.halt(context)
    return "configured-workloads-blocked" if apply else "stopped"


class Backend:
    def __init__(self):
        # Never forward the manager's enrollment credentials/tokens to this child.
        self.env = {"PATH": "/usr/sbin:/usr/bin", "LANG": "C.UTF-8"}

    def run(self, args):
        result = subprocess.run(args, env=self.env, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=10)
        if result.returncode:
            raise ControlError("Controller command failed; raw output suppressed")
        return result.stdout

    @staticmethod
    def identity(context):
        try:
            user = pwd.getpwnam(context["username"])
            numeric = pwd.getpwuid(context["uid"])
        except KeyError:
            raise ControlError("Enrolled NSS identity is missing") from None
        if (user.pw_uid, user.pw_gid, user.pw_dir, numeric.pw_name) != (
                context["uid"], context["gid"], "/home/" + context["username"], context["username"]):
            raise ControlError("Enrolled NSS identity diverged; refusing to target another user")

    def enrollment(self, context):
        if self.state([], "personal-os-account.service") != b"active" or socket.gethostname() != context["hostname"]:
            raise ControlError("Account/hostname enrollment is not ready")
        if Path("/sys/fs/selinux/enforce").read_text().strip() != "1":
            raise ControlError("Configuration requires enforcing SELinux")

    def state(self, scope, unit):
        return self.run(["/usr/bin/systemctl", *scope, "show", "--property=ActiveState", "--value", unit]).strip()

    def halt_unit(self, scope, unit):
        if self.state(scope, unit) not in STOPPED:
            self.run(["/usr/bin/systemctl", *scope, "stop", unit])  # Synchronous; no --no-block.
        if self.state(scope, unit) not in STOPPED:
            raise ControlError("Workload did not stop")

    def halt(self, context):
        failed = False
        for unit in ("radicale.service", "syncthing@" + context["username"] + ".service"):
            try:
                self.halt_unit([], unit)
            except (ControlError, OSError, subprocess.SubprocessError):
                failed = True  # Keep trying the remaining workload stops.
        try:
            manager = self.state([], f"user@{context['uid']}.service")
            if manager == b"active":
                scope = ["--user", "--machine=" + context["username"] + "@.host"]
                try:
                    self.run(["/usr/bin/systemctl", *scope, "daemon-reload"])
                except (ControlError, OSError, subprocess.SubprocessError):
                    failed = True
                # Timers first, then services; never stop the manager or SSH.
                for unit in USER_UNITS:
                    try:
                        self.halt_unit(scope, unit)
                    except (ControlError, OSError, subprocess.SubprocessError):
                        failed = True
            elif manager not in STOPPED:
                failed = True  # Don't create/start a manager while stopping.
        except (ControlError, OSError, subprocess.SubprocessError):
            failed = True
        if failed:
            raise ControlError("Workload stopping/verification incomplete; configuration blocked")

    @staticmethod
    def child_command(context):
        home = "/home/" + context["username"]
        return ["/usr/sbin/runuser", "--user", context["username"], "--", "/usr/bin/env", "-i",
                "PATH=/usr/sbin:/usr/bin", "LANG=C.UTF-8", "HOME=" + home,
                "USER=" + context["username"], "LOGNAME=" + context["username"],
                "/usr/libexec/personal-os-chezmoi"]

    def apply(self, context):
        # Dedicated session permits timeout cleanup of runuser AND its descendants.
        # The systemd unit's control-group kill covers cancellation/escaped groups.
        with subprocess.Popen(self.child_command(context), env=self.env, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, start_new_session=True) as child:
            try:
                child.communicate(timeout=480)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                child.communicate()
                raise ControlError("Target-user configuration timed out; raw output suppressed") from None
            if child.returncode:
                raise ControlError("Target-user configuration failed; workloads remain blocked")


def main():
    try:
        if os.geteuid() != 0 or not Path("/usr/lib/personal-os/account-provisioning").is_file():
            raise ControlError("Controller is restricted to the root target profile")
        if sys.argv[1:] not in ([], ["--stop"]):
            raise ControlError("Unsupported controller arguments")
        os.umask(0o077)
        with Runtime() as runtime:
            control(runtime, Backend(), apply=sys.argv[1:] != ["--stop"])
    except ControlError as error:
        print("personal-os controller failed: " + str(error), file=sys.stderr)
        return 1
    except (OSError, ValueError, TypeError, subprocess.SubprocessError):
        print("personal-os controller failed: protected runtime, invalid context or execution error", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
