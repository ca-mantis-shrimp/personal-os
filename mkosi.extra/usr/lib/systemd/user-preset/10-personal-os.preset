# SPDX-License-Identifier: LGPL-2.1-or-later

# Retain the operator's SSH agent; no desktop audio or smartcard service.
enable ssh-agent.service
disable p11-kit-server.service
disable pipewire.*
disable wireplumber.service
# Local CLI/Quadlet does not require an automatically listening API socket.
disable podman.socket
disable podman.service
disable podman-auto-update.timer
disable podman-restart.service

# Configuration-owned autostarts still have the profile's fail-closed drop-ins.
disable neovim-server.service
disable otelcol.service
disable syncthing.service
disable vdirsyncer.service
disable vdirsyncer.timer
