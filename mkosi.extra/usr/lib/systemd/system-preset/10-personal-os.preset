# SPDX-License-Identifier: LGPL-2.1-or-later

# Headless management plane; account enrollment/daemon SSH ordering is in the
# mini-server overlay. Keep vendor presets for core boot plumbing.
enable systemd-networkd.service
enable systemd-networkd-wait-online.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable preset-global.service
enable sshd.service
disable sshd.socket
disable ssh.socket
disable ssh.service
# Podman/Quadlet run locally without exposing a privileged management API.
disable podman.socket
disable podman.service
disable podman-auto-update.timer
disable podman-restart.service

# No desktop, smartcard daemon, demo/debug access or homed account enrollment.
disable NetworkManager.service
disable NetworkManager-wait-online.service
disable avahi.*
disable pcscd.*
disable power-profiles-daemon.service
disable gdm.service
disable sddm.service
disable debug-shell.service
disable systemd-homed.service
disable systemd-homed-firstboot.service

# Workloads require deliberately granted configuration/runtime readiness.
disable radicale.service
disable syncthing@.service
